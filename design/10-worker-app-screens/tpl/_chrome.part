    /* the plate (§9) marks the RECORD. A settings sheet is not one, so the
       corners appear on the record surface and nowhere else. */
    .plate{position:absolute;inset:0;pointer-events:none}
    .reg{position:absolute;width:11px;height:11px;border:0 solid var(--rule)}
    .row{display:flex;gap:12px;align-items:flex-start;padding:12px 0;
         border-bottom:1px solid var(--hairline);width:100%}
    .row-sel{border-bottom:1.5px solid var(--rule)}
    .gutter{flex:0 0 26px;padding-top:4px}
    .sechead{display:flex;justify-content:space-between;align-items:baseline;
             border-bottom:1px solid var(--ink);padding-bottom:8px;gap:12px}
    .icon{stroke:var(--ink);stroke-width:1.5;fill:none;stroke-linecap:square}
    .col-r{text-align:right;white-space:nowrap;padding-top:2px}
    main::-webkit-scrollbar{width:0}

    /* §9's sine-modulated divider and the rung scale live in the chassis, not in
       one screen's helmet: both are shared vocabulary, and a class defined in
       Main only meant every other screen rendered them unstyled. */
    .sinerule{margin-top:-2px;line-height:0;opacity:.9}
    /* No .rung. It drew the seven measures as a graded ladder, and decision 054
       renders nothing derived from them: a ladder with a mark on it is an
       ordinal whether or not the number is printed. */

    /* Provenance is carried by the mark, and the sentence it stands for is
       reachable on hover, tap and keyboard focus (055). The sentence also stays
       in the DOM as the mark's accessible name, which is the text equivalent
       §12 requires and the only provenance a crawler can read. One string
       serves all three. Enforced by reading. */
    .prov{position:relative;flex:0 0 auto;min-width:44px;min-height:44px;
          display:inline-flex;align-items:center;justify-content:flex-start;
          margin-left:-4px;padding-left:4px}
    /* opacity, never visibility or display: a hidden-by-visibility tip leaves
       the accessibility tree and the crawler gets nothing, which would defeat
       the whole point of keeping one string. */
    .prov .tip{position:absolute;left:0;top:calc(100% - 6px);z-index:6;
               background:var(--ink);color:var(--paper);padding:8px 12px;
               width:max-content;max-width:min(260px, 68vw);text-align:left;
               opacity:0;pointer-events:none;transition:opacity 110ms linear}
    .prov:hover .tip,.prov:focus-visible .tip{opacity:1;pointer-events:auto}
    /* 1.4.13 wants the revealed content hoverable. It stays up while the
       pointer is on it. Enforced by reading. */
    .prov .tip:hover{opacity:1;pointer-events:auto}
    @media (prefers-reduced-motion:reduce){ .prov .tip{transition:none} }
    /* The imprint is capped and centred wherever it appears. A fluid root with an
       uncapped figure grows until the figure swallows the display, the defect
       fixed on the record and still live on three other screens. 320 is the size
       it is drawn and thread-budgeted at (044). */
    .imprint{display:block;width:100%;max-width:320px;margin-inline:auto}
    /* An instrument reading: the figure and what it counts. baseline alignment
       hung the small text off the numeral's foot, which reads as two things that
       missed each other. The text block is centred against the numeral instead,
       and the numeral gets its own optical trim, a 40px 800-weight Expanded
       figure sits high in its line box. */
    .reading{display:flex;align-items:center;gap:14px}
    .reading .t-inst{flex:0 0 auto;line-height:.82;position:relative;top:1px}
    .reading > span:last-child{flex:1;min-width:0}
    /* A row that goes somewhere says so. Rows that only state a fact carry no
       chevron, since a fact dressed as a control lies about what can be changed. */
    .chev{flex:0 0 16px;display:flex;align-items:center;padding-left:4px}
    /* The bottom of a scroller is where the system's own bar begins. Content that
       simply stops there reads as cut off, and a large empty band reads as a
       mistake. `.dissolve` fades the last 28px of the scroll into the paper, so
       the record ends rather than being truncated, and the home indicator has
       something to sit against. 28 is the smallest band that reads as intentional
       at the 16px body size, below that it is a hairline nobody sees. */
    .dissolve{-webkit-mask-image:linear-gradient(to bottom, #000 calc(100% - 28px), transparent 100%);
              mask-image:linear-gradient(to bottom, #000 calc(100% - 28px), transparent 100%)}
    @media (prefers-reduced-transparency:reduce){
      .dissolve{-webkit-mask-image:none;mask-image:none}
    }

    /* A pushed screen, which is a shape the app did not have. `design/08` §3:
       the sheets carry a Close and nothing drew a back affordance, because iOS
       takes the left edge and Android's gesture nav takes both, so an edge
       swipe is the platform's and not ours (048). A drawn back control is the
       only honest answer. */
    .pushhead{height:52px;display:flex;align-items:center;gap:4px;padding:0 8px 0 4px;
              border-bottom:1px solid var(--hairline);position:relative;z-index:3;
              background:var(--paper);flex:0 0 auto}
    .pushhead .t-serial{flex:1;min-width:0}
    .iconbtn{width:44px;height:44px;display:flex;align-items:center;justify-content:center;
             flex:0 0 44px}
    .iconbtn svg{stroke:var(--ink);stroke-width:1.5;fill:none;stroke-linecap:butt;
                 stroke-linejoin:miter}
    /* A fixed action band at the foot of a pushed screen. Sits above the
       dissolve so a primary control is never faded by it. */
    .actions{position:absolute;left:0;right:0;bottom:0;padding:16px 20px;
             background:var(--paper);border-top:1px solid var(--ink);z-index:4}

    /* §12 says loading is the scribing arc, never a spinner, and nothing drew
       it. One lobe period of the figure's own wave, scribed and released. It
       carries no percentage, because an arc that pretends to know how long is
       the same lie as a spinner that pretends to make progress. */
    .arc{display:block;margin-inline:auto}
    .arc path{stroke-dasharray:1;stroke-dashoffset:1;
              animation:arcscribe 1400ms cubic-bezier(0.4,0,0.2,1) infinite}
    @keyframes arcscribe{
      0%{stroke-dashoffset:1}
      55%{stroke-dashoffset:0}
      100%{stroke-dashoffset:-1}
    }
    /* Progress, where the length IS known: a band closing on the figure's
       radius. §9 specifies it and nothing used it. */
    .band{height:3px;background:var(--hairline);overflow:hidden}
    .band i{display:block;height:100%;background:var(--ink);
            transition:width 320ms cubic-bezier(0.2,0,0,1)}
    @media (prefers-reduced-motion:reduce){
      .arc path{animation:none;stroke-dashoffset:0}
      .band i{transition:none}
    }

    /* The state grammar as a control, not a platform switch (`design/08` §2).
       On is ink filled to the right, off is the rule alone: the same
       ink-versus-rule distinction every other state in the system uses, so
       nobody has to learn a second vocabulary for a setting. */
    /* The control is 46x44 so it clears §12's target floor; the track it draws
       is 26 tall and sits inside that. A 26px-high switch was the shape the
       platform switches use and it fails 2.5.8 on both of them. */
    .sw{flex:0 0 auto;width:46px;height:44px;border:0;background:none;padding:0;
        position:relative}
    .sw::before{content:'';position:absolute;left:0;right:0;top:9px;height:26px;
                border:1px solid var(--rule);border-radius:3px;box-sizing:border-box}
    .sw i{position:absolute;top:13px;left:4px;width:18px;height:18px;
          background:var(--rule);transition:left 140ms cubic-bezier(0.2,0,0,1),
          background-color 140ms linear}
    .sw[aria-checked="true"]::before{border-color:var(--ink)}
    .sw[aria-checked="true"] i{left:24px;background:var(--ink)}
    @media (prefers-reduced-motion:reduce){ .sw i{transition:none} }

    /* Nothing in the system acknowledged a completed action. Inline, in ink,
       under the thing that changed, never a floating toast that steals focus. */
    .said{display:flex;gap:8px;align-items:flex-start;padding:10px 0 0}
    .said svg{flex:0 0 16px;margin-top:2px;stroke:var(--ink);stroke-width:1.5;fill:none}

    /* A list that has not arrived yet. Rules at the row rhythm, no shimmer:
       §5 forbids a moving gradient and the rhythm alone reads as structure. */
    .skel{border-bottom:1px solid var(--hairline);padding:14px 0}
    .skel span{display:block;height:9px;background:var(--hairline)}
    .skel span + span{margin-top:8px;width:58%}

    /* Promoted from three screen helmets, where they had already drifted to two
       different paddings. A settings-style group, its rows, and the one block
       in the system that raises its voice. */
    .grp{padding-top:24px}
    .srow{display:flex;gap:12px;align-items:baseline;padding:12px 0;
          border-bottom:1px solid var(--hairline);width:100%;min-height:44px;
          text-align:left}
    .warn{background:var(--ink);color:var(--paper);padding:14px 16px}
    .warn .t-data{color:var(--paper)}

    /* §8's input: a hairline you type on, focus thickens ink-ward, an error
       thickens it further and speaks in ink rather than colour (law 8). It
       existed in ten copies across five divergent variants, which is the defect
       _chrome.part was written to prevent, committed against the control the
       app uses most. Reconciled: centre alignment, no padding under the rule
       (the input's own padding sets the height), .bad for the error, and 16px
       because anything smaller makes iOS zoom the viewport on focus and the
       screen never comes back. .lg is the name field, which is the one place a
       larger value is the point. */
    .ruled{display:flex;align-items:center;border-bottom:1px solid var(--rule)}
    .ruled:focus-within{border-bottom:2px solid var(--ink)}
    .ruled.bad{border-bottom:2.5px solid var(--ink)}
    .ruled input{border:0;outline:0;background:none;font:inherit;color:var(--ink);
                 flex:1;min-width:0;padding:12px 0;font-weight:600;font-size:16px;
                 min-height:44px;box-sizing:border-box}
    .ruled.lg input{font-size:18px}
    /* A multi-line field is the same object with room to grow. */
    .ta{width:100%;min-height:132px;border:0;border-bottom:1px solid var(--rule);
        background:none;font:inherit;font-size:16px;color:var(--ink);outline:0;
        padding:12px 0;resize:none}
    .ta:focus{border-bottom:2px solid var(--ink)}

    /* The reader-facing row. Three screens carried their own copy. */
    .prow{display:flex;gap:12px;align-items:flex-start;padding:14px 0;
          border-bottom:1px solid var(--hairline)}
    /* A key and its value, for a screen that lists raw facts. */
    .drow{display:flex;gap:14px;align-items:flex-start;padding:12px 0;
          border-bottom:1px solid var(--hairline)}
    .dk{flex:0 0 108px;padding-top:2px}
