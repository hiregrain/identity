<svg width="0" height="0" style="position:absolute" aria-hidden="true"><defs>
  <!-- §8's set: 24px grid, 1.5px hairline, square terminals, never filled.
       Close, index and capture existed; back, add, camera, link, tick and
       alert are the rest of what the screens below actually reach for. -->
  <g id="i-back"><path d="M14.5 5 L7.5 12 L14.5 19"/></g>
  <g id="i-add"><path d="M12 5 L12 19"/><path d="M5 12 L19 12"/></g>
  <g id="i-camera"><path d="M3.5 7.5 L8 7.5 L9.5 5.5 L14.5 5.5 L16 7.5 L20.5 7.5 L20.5 18.5 L3.5 18.5 Z"/><circle cx="12" cy="13" r="3.6"/></g>
  <g id="i-link"><path d="M13 5.5 L18.5 5.5 L18.5 11"/><path d="M18.5 5.5 L10.5 13.5"/><path d="M15.5 14.5 L15.5 18.5 L5.5 18.5 L5.5 8.5 L9.5 8.5"/></g>
  <!-- No tick. DESIGN.md §8 is flat: the product contains no checkmarks, and
       the same sentence names what replaces one, the state grammar. A step that
       is done is filled; a step that is not is hollow. A tick beside an identity
       claim is the verified badge 027 prohibits, arriving through the icon set. -->
  <g id="i-done"><rect x="7" y="7" width="10" height="10" fill="#1B2A44" stroke="none"/></g>
  <g id="i-open"><rect x="7.5" y="7.5" width="9" height="9"/></g>
  <g id="i-alert"><path d="M12 4.5 L21 19.5 L3 19.5 Z"/><path d="M12 10 L12 14"/><path d="M12 16.4 L12 17.2"/></g>
</defs></svg>
